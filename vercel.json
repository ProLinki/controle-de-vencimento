{
  "version": 2,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/manifest.json", "headers": { "Access-Control-Allow-Origin": "*" } },
    { "src": "/service-worker.js", "headers": { "Access-Control-Allow-Origin": "*" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}