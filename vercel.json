{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/manifest.json", "headers": { "Access-Control-Allow-Origin": "*" } },
    { "src": "/service-worker.js", "headers": { "Access-Control-Allow-Origin": "*" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-notifications", "schedule": "0 11 * * *" }
  ]
}